#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=modules/usage/files/usage-lib.sh
source "$(dirname "$0")/usage-lib.sh"
input=$(cat)
line="Current local time: $(date '+%A %Y-%m-%d %H:%M %Z')"
read -r c cr cw cwr x xr xw xwr < <(usage_snapshot | usage_values)
c=$(usage_percent "$c" "$cr"); cw=$(usage_percent "$cw" "$cwr")
x=$(usage_percent "$x" "$xr"); xw=$(usage_percent "$xw" "$xwr")
if [[ -z ${CREW_AGENT:-} ]]; then
  [[ -z $c ]] || line+=" · Claude 5h $c% · week ${cw:-unknown}%"
  [[ -z $x ]] || line+=" · Codex 5h $x% · week ${xw:-unknown}%"
  if [[ -n ${CLOUD_CREDIT_UNTIL:-} ]]; then
    end=$(date -d "$CLOUD_CREDIT_UNTIL" +%s 2>/dev/null || date -j -f '%Y-%m-%dT%H:%M:%SZ' "$CLOUD_CREDIT_UNTIL" +%s 2>/dev/null || echo 0)
    balance=${XDG_DATA_HOME:-$HOME/.local/share}/cloud-runs/balance.tsv
    if (( end > usage_now )) && [[ -s $balance ]]; then
      line+=" · Cloud $(tail -1 "$balance" | cut -f2) ($(( (end-usage_now)/86400 ))d)"
    fi
  fi
fi
log=${XDG_DATA_HOME:-$HOME/.local/share}/usage-log/usage.tsv
mkdir -p "${log%/*}"
[[ -s $log ]] || printf 'time\tsession\tclaude_5h\tclaude_week\tcodex_5h\tcodex_week\n' >"$log"
sid=$(jq -r '.session_id // "unknown" | gsub("[\\t\\r\\n]"; "")' <<<"$input" 2>/dev/null || echo unknown)
printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "${CREW_AGENT:+crew:}$sid" "$c" "$cw" "$x" "$xw" >>"$log"
jq -cn --arg c "$line" '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$c}}'
