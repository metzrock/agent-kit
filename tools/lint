#!/usr/bin/env bash
set -euo pipefail
files=()
while IFS= read -r -d '' file; do
  case "$file" in *.bats) continue ;; esac
  if [[ $(head -1 "$file") == '#!/usr/bin/env bash' ]]; then files+=("$file"); fi
done < <(git ls-files --cached --others --exclude-standard -z)
shellcheck -x ${files[@]+"${files[@]}"}
