# Recorded by tests/e2e/run.sh --record addons, in a throwaway HOME.
Output docs/demo/addons.gif
Set Shell bash
Set FontSize 20
Set Width 1280
Set Height 640
Set Padding 24
Set Theme "Rose Pine"
Set TypingSpeed 35ms
Set Framerate 15

Hide
Type "export HOME=$DEMO_HOME PATH=$DEMO_PATH KIT=$DEMO_KIT PS1='$ ' && cd $KIT && clear"
Enter
Type "bin/agent-kit install --modules base --yes >/dev/null && clear"
Enter
Sleep 3s
Show
Type "agent-kit install --modules writing"
Sleep 300ms
Enter
Wait+Screen@120s /Run this upstream command/
Sleep 3s
Enter
Sleep 800ms
Hide
Sleep 40s
Show
Sleep 3.5s
Enter
Hide
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 8s
Enter
Sleep 10s
Type "clear"
Enter
Sleep 1s
Show
Type "agent-kit list"
Sleep 300ms
Enter
Sleep 4s
