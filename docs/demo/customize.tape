# Recorded by tests/e2e/run.sh --record customize, in a throwaway HOME.
Output docs/demo/customize.gif
Set Shell bash
Set FontSize 20
Set Width 1280
Set Height 640
Set Padding 24
Set Theme "Rose Pine"
Set TypingSpeed 35ms
Set Framerate 15

Hide
Type "export HOME=$DEMO_HOME PATH=$DEMO_PATH KIT=$DEMO_KIT PS1='$ ' && cd $KIT && clear"
Enter
Type "bin/agent-kit install --modules base --yes >/dev/null && clear"
Enter
Sleep 3s
Show
Type "agent-kit customize"
Sleep 300ms
Enter
Sleep 1.5s
Down
Sleep 500ms
Down
Sleep 500ms
Up
Sleep 800ms
Enter
Sleep 2s
Enter
Sleep 1.5s
Enter
Sleep 2.5s
Down
Sleep 700ms
Enter
Sleep 1.2s
Down
Sleep 700ms
Enter
Sleep 3s
